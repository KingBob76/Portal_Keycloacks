# Copy these keys into D:\PIDC\GLPI\.env and fill the values locally.
# Never send the secret or user token in chat.
KEYCLOAK_SYNC_CLIENT_ID=glpi-user-sync
KEYCLOAK_SYNC_CLIENT_SECRET=
GLPI_SYNC_USER_TOKEN=
# Optional; required only if the GLPI API client enforces an App-Token.
GLPI_SYNC_APP_TOKEN=
# Default interval is 60 seconds.
SYNC_INTERVAL_SECONDS=60
# Default false: the first launch takes a baseline without importing all old users.
SYNC_IMPORT_EXISTING=false
