server {
    listen 8080;
    server_name _;
    resolver 127.0.0.11 ipv6=off valid=30s;

    # Keycloak's public realm endpoints are required for Portal PID SSO.
    location ^~ /realms/portal-pid/ {
        proxy_pass http://host.docker.internal:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-GLPI-Tunnel-Key "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $http_x_forwarded_port;
    }

    # The Admin Console is opened locally at 127.0.0.1:8080, but its browser
    # login uses the public issuer. Forward only the master realm's OIDC/login
    # paths; keep /admin and all other Keycloak paths inaccessible publicly.
    location = /realms/master/.well-known/openid-configuration {
        proxy_pass http://host.docker.internal:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-GLPI-Tunnel-Key "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $http_x_forwarded_port;
    }

    location ^~ /realms/master/protocol/openid-connect/ {
        proxy_pass http://host.docker.internal:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-GLPI-Tunnel-Key "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $http_x_forwarded_port;
    }

    location ^~ /realms/master/login-actions/ {
        proxy_pass http://host.docker.internal:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-GLPI-Tunnel-Key "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $http_x_forwarded_port;
    }

    # Keycloak login themes load JavaScript, CSS, fonts, and images from
    # /resources/. These are static assets; forwarding them is required for
    # the public SSO login page to render. Other Keycloak paths remain blocked.
    location ^~ /resources/ {
        proxy_pass http://host.docker.internal:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Host $http_x_forwarded_host;
        proxy_set_header X-Forwarded-Port $http_x_forwarded_port;
    }

    location ^~ /apirest.php/ {
        if ($http_x_glpi_tunnel_key != "${GLPI_TUNNEL_KEY}") {
            return 403;
        }

        set $glpi_backend http://172.30.77.2:80;
        proxy_pass $glpi_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-GLPI-Tunnel-Key "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        return 404;
    }
}
