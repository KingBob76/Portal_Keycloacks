VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=portal-pid
VITE_KEYCLOAK_CLIENT_ID=portal-pid

# Server-side only for Vercel Function: never rename these to VITE_ variables.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=portal-pid
KEYCLOAK_EVENTS_CLIENT_ID=portal-pid-events-reader
KEYCLOAK_EVENTS_CLIENT_SECRET=

# Server-only GLPI legacy REST API credentials. Never expose these as VITE_ variables.
GLPI_API_URL=http://localhost:32769/apirest.php
GLPI_USER_TOKEN=
GLPI_APP_TOKEN=
# Optional Cloudflare Access Service Token for a protected GLPI tunnel.
# Keep these server-side; never prefix them with VITE_.
GLPI_CF_ACCESS_CLIENT_ID=
GLPI_CF_ACCESS_CLIENT_SECRET=
# Only set this when GLPI_API_URL uses the temporary Quick Tunnel proxy.
GLPI_TUNNEL_KEY=
